# Build Dockerfile.test-base as turbojam:test-base before building this image.
ARG TEST_BASE_IMAGE=turbojam:test-base

FROM ${TEST_BASE_IMAGE}
USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    wget \
    screen vim-nox dnsutils iputils-ping net-tools strace \
    gdb mc \
    gcovr pv gawk telnet whois jq \
    sloccount \
    && rm -rf /var/lib/apt/lists/*

COPY --chown=dev:dev docker-dev.sh /home/dev/docker-dev.sh

USER dev
ENV NODE_PATH=/usr/lib/node_modules
WORKDIR /home/dev

EXPOSE 8888
CMD ["/bin/bash", "/home/dev/docker-dev.sh"]
