ARG TEST_BASE_IMAGE=turbojam:test-base

FROM ${TEST_BASE_IMAGE} AS builder
COPY --chown=dev:dev 3rdparty /home/dev/turbojam/3rdparty
COPY --chown=dev:dev lib /home/dev/turbojam/lib
COPY --chown=dev:dev src /home/dev/turbojam/src
COPY --chown=dev:dev CMakeLists.txt /home/dev/turbojam/

WORKDIR /home/dev/turbojam
RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=clang++-21 \
    && cmake --build build -t tjam

FROM ubuntu:26.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
LABEL org.opencontainers.image.source="https://github.com/r2rationality/turbojam"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libboost-json-dev \
    libboost-container-dev \
    libboost-coroutine-dev \
    libboost-context-dev \
    libboost-url-dev \
    libboost-thread-dev \
    libboost-atomic-dev \
    libboost-stacktrace-dev \
    libfmt-dev \
    libspdlog-dev \
    libzstd-dev \
    libssl-dev \
    libsodium-dev \
    libatomic1 \
    libnuma-dev \
    liblmdb-dev \
    libngtcp2-dev \
    libngtcp2-crypto-gnutls-dev \
    libgnutls28-dev \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -d /opt/tjam tjam \
    && install -d -o tjam -g tjam -m 1777 /opt/tjam/log
RUN chmod 0755 /opt/tjam
COPY --from=builder /home/dev/turbojam/build/tjam /usr/local/bin/tjam
COPY --chown=tjam:tjam --chmod=0755 data /opt/tjam/data
RUN find /opt/tjam/data -type f -exec chmod 644 {} \;

USER tjam
WORKDIR /opt/tjam
ENV TURBO_LOG_PATH=/opt/tjam/log/tjam.log
ENTRYPOINT ["/usr/local/bin/tjam", "fuzzer-api"]
